{
  "name": "dsh-compact-saviour",
  "version": "0.2.6",
  "description": "Dedicated-model compaction rescue and manual compaction in the native context popup",
  "type": "module",
  "license": "MIT",
  "main": "lib/dsh-compact-saviour.js",
  "types": "lib/types/dsh-compact-saviour.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/dsh-compact-saviour.d.ts",
      "default": "./lib/dsh-compact-saviour.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && node scripts/normalize-artifacts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "link:harness": "node scripts/link-harness-dependencies.mjs",
    "test:browser": "node tests/meter-bridge.browser.mjs && node tests/interaction.browser.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.0",
    "typescript": "^6.0.3",
    "tsx": "^4.22.4",
    "tsdown": "^0.22.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "semver": "7.8.5",
    "@deepseek-ai/cordis-plugin-loader": "*"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "tests",
    "cordis.yml",
    "dshx.yml",
    "tsconfig.json",
    "tsdown.config.ts",
    "README.md",
    "ACCEPTANCE.md",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-compact-saviour.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-compact-saviour#readme",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-compact-saviour/issues"
  }
}
